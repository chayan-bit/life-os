# Secrets & env
.env
.env.*
!.env.example
*.pem
*.key
secrets/
connections.local.*

# Databases & derived state (never commit data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/local/
store/*.local.json
memvec.db
*.npy

# Nango OAuth-vault Postgres datadir (bind-mounted by infra/nango/docker-compose.yml).
# Raw pg heap files have no extension, so the *.db/*.sqlite rules miss them - and this
# holds encrypted OAuth tokens. Never commit it.
infra/nango/data/
infra/gowa/data/

# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build & cache
dist/
build/
# server/build/ is source (the self-extension build pipeline, #132), not output.
!server/build/
.cache/
.wrangler/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/

# Stray agent-CLI scratch worktrees (Codex / OpenCode), not part of the project
.codex/
.opencode/

# Rust build artifacts
/services/target/
target/
*.derived
test_*.db

# lifeos-vcs CAS blob storage (local dev runs)
/services/lifeos-blobs/
*.blobs/

# whisper.cpp GGML models (issue #89) - downloaded locally, not committed
/services/.whisper-models/
*.ggml.bin
ggml-*.bin

# Self-eval regression suite run history (issue #140) - local/CI run output,
# not source; scenarios.json + run.js ARE committed, this log is not, to
# avoid commit noise on every eval run.
/server/evals/history.jsonl
