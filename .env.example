# Life OS environment - copy to .env and `source .env` (or export per shell).
# EVERYTHING here is optional: with zero configuration Life OS runs fully
# local (SQLite file DB, keyless AI through whatever agent CLI is on PATH).
# The one exception is strict/shared mode (LIFEOS_TRUST_WORKSPACE_HEADER=0),
# which REQUIRES a real LIFEOS_JWT_SECRET - see the Tenancy section below.

# ── Core (all have working defaults) ────────────────────────────────────────
# LIFEOS_DB_PATH=lifeos.db                 # canonical DB file (libSQL/SQLite)
# LIFEOS_DERIVED_DB_PATH=lifeos-derived.db # un-synced derived store (FTS5/vec)
# LIFEOS_BIND_ADDR=127.0.0.1:8080          # API bind address (localhost-only)
# LIFEOS_VCS_BLOB_ROOT=lifeos-blobs        # content-addressed blob store root
# LIFEOS_SERVER_DIR=server                 # dir the JS agent runtime is spawned in

# ── Tenancy & CORS (security) ───────────────────────────────────────────────
# LIFEOS_TRUST_WORKSPACE_HEADER=1  # 1/unset = personal, local-first (an
#                                  # x-workspace-id header or body workspace_id
#                                  # is trusted outright). Set to 0 for shared/
#                                  # SaaS: identity must be proven by a verified
#                                  # JWT and the JWT's workspace claim is
#                                  # authoritative. In this mode LIFEOS_JWT_SECRET
#                                  # is MANDATORY (startup hard-fails without a
#                                  # unique, >=32-char secret).
# LIFEOS_JWT_SECRET=               # HMAC secret for session JWTs. Local-first:
#                                  # random ephemeral secret is minted if unset
#                                  # (tokens do not survive a restart - set this
#                                  # to persist sessions). Strict mode: REQUIRED,
#                                  # must be unique and >=32 chars.
# LIFEOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#                                  # comma-separated browser origin allow-list.
#                                  # Unset = the two Vite dev-server origins.

# ── AI engine (keyless - local agent CLIs are the engine) ──────────────────
# LIFEOS_AGENT=claude              # default agent CLI (claude|gemini|codex|
#                                  # opencode|hermes|antigravity|openclaw);
#                                  # unset = first detected on PATH
# LIFEOS_AGENT_MODEL=              # default model override (e.g. haiku)
# LIFEOS_AGENT_CWD=                # cwd the agent CLI is spawned in
# LIFEOS_AGENT_TIMEOUT_SECS=180
# LIFEOS_MEMORY_MODEL=             # set to `agent` to route memory recall
#                                  # through the agent-CLI router; unset = the
#                                  # deterministic, no-LLM path
# ANTHROPIC_API_KEY=               # OPTIONAL fallback lane, only consulted
#                                  # when no agent CLI is found on PATH

# ── Always-on cloud sync (optional - Turso/libSQL embedded replica) ────────
# TURSO_URL=libsql://<db>.turso.io
# TURSO_TOKEN=
# LIFEOS_SYNC_INTERVAL_SECS=60
# TURSO_PLATFORM_API_TOKEN=        # db-per-workspace provisioning (SaaS mode)
# TURSO_ORG_SLUG=

# ── Blob mirror (optional - out-of-band CAS sync to Cloudflare R2) ─────────
# Blobs (video/image/audio/design) sync to object storage, never through libSQL.
# All four are needed together; unset = local-only blob store.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=lifeos-blobs
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ── Drain (heavy-lane job worker) ───────────────────────────────────────────
# LIFEOS_NODE_ID=                  # stable node id stamped on claim events;
#                                  # unset = the machine hostname
# LIFEOS_BUILD_PIPELINE=1          # trusted-node gate: 1/unset = run
#                                  # self-extension codegen; 0 = untrusted node
#                                  # (codegen disabled, module_requests not polled)
# LIFEOS_WHISPER_MODEL=            # path to a GGML whisper model (audio ingest)
# LIFEOS_FFMPEG_BIN=               # ffmpeg CLI; needed to decode OGG/Opus voice
#                                  # notes (symphonia has no Opus decoder)
# LIFEOS_MEMVEC=                   # path to memvec.py (semantic embedding)
# LIFEOS_TESSERACT_BIN=            # tesseract CLI (OCR lane)
# LIFEOS_MEMORY_SLEEP_THRESHOLD=25 # unconsolidated-importance sleep trigger
# PIPELINE_EVAL_SAMPLE_RATE=0.2    # fraction of eval-gated stages sampled
# LIFEOS_DRAIN_POLL_SECS=3         # job-queue poll interval
# LIFEOS_DRAIN_STUCK_TTL_SECS=300  # reclaim a job stuck in `claimed` after this
# LIFEOS_DRAIN_MAX_ATTEMPTS=3      # max attempts before a job is failed

# ── Telegram (optional - bot notifications & digests) ───────────────────────
# TELEGRAM_BOT_TOKEN=              # same token as the Worker's BOT_TOKEN;
#                                  # unset = build/module notifications logged only
# TELEGRAM_ADMIN_CHAT_ID=          # chat id for gated pipeline rationales/digests

# ── PWA Web Push (optional - VAPID keypair, issue #103/#151) ────────────────
# Generate with: node server/scripts/generateVapidKeys.js
# All three needed; the public key must also reach lifeos-api (it serves it at
# GET /api/push/vapid-public-key for the frontend's subscribe call).
# LIFEOS_VAPID_PUBLIC_KEY=
# LIFEOS_VAPID_PRIVATE_KEY=
# LIFEOS_VAPID_SUBJECT=            # mailto: or https URL identifying the sender

# ── CLI / server tooling ────────────────────────────────────────────────────
# LIFEOS_API_URL=http://127.0.0.1:8080     # base URL the CLI + JS agent call
# LIFEOS_WORKSPACE_ID=default-personal-workspace  # default workspace for scripts

# ── Owned-credential integrations (all optional, docs/INTEGRATIONS.md) ─────
# NANGO_SERVER_URL=                # self-hosted Nango (OAuth vault)
# NANGO_SECRET_KEY_DEV=
# LIFEOS_SECRET_ENCRYPTION_KEY=    # envelope encryption for non-Nango secrets
# KITE_API_KEY=                    # Zerodha Kite (READ-ONLY by design)
# KITE_API_SECRET=
# GOWA_BASE_URL=                   # self-hosted WhatsApp bridge
# GOWA_BASIC_AUTH=
# GOWA_WEBHOOK_SECRET=
# BROWSER_ACTUATOR_SCRIPT=         # gated browser actuator entrypoint
# LIFEOS_MARKETPLACE_SIGNING_SEED= # module marketplace signing key
